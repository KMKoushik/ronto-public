{
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "name": "@ronto/server",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "browser:install": "agent-browser install",
    "browser:doctor": "agent-browser doctor --json",
    "check": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config src/auth/auth.ts --output src/db/migrations/0001-better-auth.sql --yes",
    "auth:migrate": "auth migrate --config src/auth/auth.ts --yes",
    "db:migrate": "pnpm auth:migrate && node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "summaries:backfill": "node --env-file-if-exists=.env --import tsx src/db/enqueue-summary-backfill.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@raindrop-ai/pi-agent": "0.2.2",
    "@ronto/api": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "agent-browser": "0.35.1",
    "better-auth": "^1.7.2",
    "effect": "4.0.0-rc.112",
    "htmlparser2": "10.0.0",
    "mime": "4.1.0",
    "turndown": "7.2.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "auth": "^1.7.2"
  }
}
