BETTER_AUTH_SECRET=generate-with-pnpm-auth-secret
PORT=3141
HOST=127.0.0.1
BETTER_AUTH_URL=http://localhost:3141
WEB_URL=http://localhost:2718
DATABASE_PATH=../../data/ronto.sqlite
FAMILY_STORAGE_PATH=../../data/families
# Linux rootless Podman image ID (sha256:<64 hex digits>), after offline slot provisioning.
# Unset means Bash fails closed; there is no host Bash fallback.
# Do not admit another real family until the live integration acceptance gate passes.
RONTO_SANDBOX_IMAGE=
# Required on first bootstrap: must match exactly one existing Better Auth user.
PLATFORM_ADMIN_EMAIL=
OPENAI_API_KEY=
OPENCODE_API_KEY=
EXA_API_KEY=
AGENT_BROWSER_EXECUTABLE_PATH=
RAINDROP_WRITE_KEY=local
RAINDROP_PROJECT_ID=
WHATSAPP_ENABLED=true
WHATSAPP_COMMAND_PREFIX=/ronto
OPEN_CONNECTOR_URL=
OPEN_CONNECTOR_DATA_PATH=../../data/open-connector-runtime
OPEN_CONNECTOR_ADMIN_TOKEN=
OPEN_CONNECTOR_SIDECAR_ENCRYPTION_KEY=
CONNECTOR_TOKEN_ENCRYPTION_KEY=
OPEN_CONNECTOR_ALLOWED_CUSTOM_OAUTH=
