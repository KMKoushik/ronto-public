FROM docker.io/library/ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl file findutils git grep imagemagick jq nodejs npm \
      openssh-client poppler-utils procps python3 python3-docx python3-fitz \
      python3-openpyxl python3-pil python3-pypdf python3-reportlab python3-venv \
      qpdf ripgrep sed tar tini unzip util-linux zip \
    && rm -rf /var/lib/apt/lists/*

# Apple container uses a VM boundary rather than a shared host kernel and does
# not expose a no-new-privileges switch. Remove every set-id bit so the forced
# non-root runtime user cannot elevate inside that VM.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +

# The runtime sets a non-root UID, read-only root filesystem, resource ceilings,
# allowlisted environment, and exactly one family bind mount. User-installed
# packages and caches belong under /workspace/.home, not the image layer.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
