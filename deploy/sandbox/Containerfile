FROM docker.io/library/ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl findutils git grep jq nodejs npm \
      openssh-client procps python3 python3-venv ripgrep sed tar tini unzip util-linux zip \
    && rm -rf /var/lib/apt/lists/*

# The runtime sets a non-root UID, read-only root filesystem, resource ceilings,
# allowlisted environment, and exactly one family bind mount. User-installed
# packages and caches belong under /workspace/.home, not the image layer.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
