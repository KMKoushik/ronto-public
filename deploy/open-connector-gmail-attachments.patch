+async function downloadAttachment(input: Record<string, unknown>, context: ActionContext) {
+  if (!context.transitFiles) {
+    throw new ProviderRequestError(503, "Gmail attachment download requires local transit file storage");
+  }
+  const messageId = normalizeMessageId(input.messageId);
+  const attachmentId = normalizeMessageId(input.attachmentId);
+  const message = await getMessageResource(context.userId, messageId, context.accessToken, context.fetcher, "full");
+  const part = findAttachmentPart(message.payload, attachmentId);
+  if (!part) {
+    throw new ProviderRequestError(404, "Gmail attachment was not found on the selected message");
+  }
+  const reportedSize = part.body?.size;
+  if (reportedSize != null && (!Number.isSafeInteger(reportedSize) || reportedSize < 0)) {
+    throw new ProviderRequestError(502, "Gmail attachment metadata contained an invalid size");
+  }
+  if (reportedSize != null && reportedSize > context.transitFiles.maxBytes) {
+    throw new ProviderRequestError(413, `Gmail attachment exceeds local transit limit of ${context.transitFiles.maxBytes} bytes`);
+  }
+  const maxEncodedBytes = Math.ceil(context.transitFiles.maxBytes / 3) * 4;
+  const response = await sendGmailRequest(
+    gmailUserUrl(context.userId, "messages", messageId, "attachments", attachmentId),
+    context.accessToken,
+    context.fetcher,
+  );
+  const attachment = asObject(await readProviderJsonBody(response, {
+    emptyBody: {},
+    invalidJsonMessage: "Gmail attachment response must be valid JSON",
+    maxBytes: maxEncodedBytes + 16 * 1024,
+  }));
+  if (typeof attachment.data !== "string") {
+    throw new ProviderRequestError(502, "Gmail attachment response did not contain file data");
+  }
+  if (Buffer.byteLength(attachment.data, "utf8") > maxEncodedBytes) {
+    throw new ProviderRequestError(413, `Gmail attachment exceeds local transit limit of ${context.transitFiles.maxBytes} bytes`);
+  }
+  if (!/^[A-Za-z0-9_-]*={0,2}$/u.test(attachment.data)) {
+    throw new ProviderRequestError(502, "Gmail attachment response contained invalid base64url data");
+  }
+  const canonicalData = attachment.data.replace(/=+$/u, "");
+  const bytes = Buffer.from(attachment.data, "base64url");
+  if (bytes.toString("base64url") !== canonicalData) {
+    throw new ProviderRequestError(502, "Gmail attachment response contained invalid base64url data");
+  }
+  if (bytes.byteLength > context.transitFiles.maxBytes) {
+    throw new ProviderRequestError(413, `Gmail attachment exceeds local transit limit of ${context.transitFiles.maxBytes} bytes`);
+  }
+  if (reportedSize != null && reportedSize !== bytes.byteLength) {
+    throw new ProviderRequestError(502, "Gmail attachment metadata size did not match the downloaded bytes");
+  }
+  if (attachment.size != null && (!Number.isSafeInteger(attachment.size) || attachment.size !== bytes.byteLength)) {
+    throw new ProviderRequestError(502, "Gmail attachment size did not match the downloaded bytes");
+  }
+  const name = part.filename || `gmail-attachment-${attachmentId.slice(0, 12)}`;
+  const mimeType = part.mimeType || "application/octet-stream";
+  const file = await context.transitFiles.create(new File([Uint8Array.from(bytes)], name, { type: mimeType }));
+  return { messageId, attachmentId, file };
+}
+
+function findAttachmentPart(payload: GmailMessagePart | undefined, attachmentId: string): GmailMessagePart | undefined {
+  if (!payload) return undefined;
+  if (payload.body?.attachmentId === attachmentId) return payload;
+  for (const part of payload.parts ?? []) {
+    const found = findAttachmentPart(part, attachmentId);
+    if (found) return found;
+  }
+  return undefined;
+}
